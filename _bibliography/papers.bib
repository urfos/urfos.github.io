  abbr = {IPP},
  title = {{Impact of in-work benefit on employment: evidence from a large reform in France}},
  author = {Bozio, Antoine and Eryzhenskiy, Ilya and T{\^o}, Maxime},
  abstract={The French in-work benefit, known as the prime d'activité, was substantially increased in January 2019, one of the flagship measures of the government's response to the "yellow vests" movement of autumn 2018. Beyond its direct effect on household purchasing power, this report evaluates the causal effect of the reform on jobseekers and recipients of minimum income benefits.},
